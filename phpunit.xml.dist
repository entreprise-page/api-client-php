<?xml version="1.0" encoding="UTF-8"?>
<!-- Compatible PHPUnit 9 (PHP 7.4) et PHPUnit 11 : pas de schéma ni d'élément propre à une version. -->
<phpunit bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="api-client">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
