{
    "name": "entreprise-page/api-client",
    "description": "Client PHP (7.4+) de l'API entreprise.page, basé sur PSR-18 et PSR-17",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "entreprise.page",
        "siren",
        "siret",
        "api",
        "psr-18"
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6 || ^11.5",
        "symfony/http-client": "^5.4 || ^6.4 || ^7.4"
    },
    "suggest": {
        "symfony/http-client": "Implémentation PSR-18 recommandée dans une application Symfony"
    },
    "autoload": {
        "psr-4": {
            "EntreprisePage\\ApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EntreprisePage\\ApiClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "php bin/generate-models.php ../../../api/docs/swagger.json src/Model",
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": [
            "phpstan analyse",
            "phpstan analyse -c phpstan-tests.neon.dist"
        ],
        "lint": [
            "@cs",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    }
}
